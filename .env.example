# ==============================================================================
# AdiTrader Environment Configuration Template
# Copy this file to .env and fill in your confidential credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ADITRADER_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Persistence / Database URLs
# Default: Standalone SQLite with WAL mode
DATABASE_URL=sqlite:///runs/aditrader.db
# Optional Dockerized Postgres:
# DATABASE_URL=postgresql+psycopg2://aditrader:aditrader_secret@localhost:5432/aditrader

# Optional In-Memory Cache / PubSub
# REDIS_URL=redis://localhost:6379/0

# Kotak Neo Broker Credentials (Read-Only Adapter)
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_MOBILE_NUMBER=your_registered_mobile_number
KOTAK_PASSWORD=your_login_password
KOTAK_MPIN=your_6_digit_mpin
KOTAK_TOTP_SECRET=your_totp_secret_key

# AI Subsystem Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Risk & Paper Trading Default Parameters
INITIAL_CAPITAL=1000000.0
MAX_MARGIN_UTILIZATION=0.85
INTRADAY_MAX_DRAWDOWN=0.05

# ==============================================================================
# QuantumValidator / AdiTrader — Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env and customize for local development:
#     cp .env.example .env
#
# SECURITY WARNING:
# Never commit .env, API keys, broker passwords, or credentials to Git.
# .env is explicitly excluded in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime Settings (Required Defaults)
# ------------------------------------------------------------------------------
ADITRADER_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Database Storage (Required Default)
# ------------------------------------------------------------------------------
# Default is local SQLite in WAL mode with busy timeout handling (ADR 008).
DATABASE_URL=sqlite:///runs/aditrader.db

# Optional Redis URL (used for distributed pub/sub in production):
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 3. Capital & Risk Engine Limits (Required Defaults)
# ------------------------------------------------------------------------------
INITIAL_CAPITAL=1000000.0
MAX_MARGIN_UTILIZATION=0.85
INTRADAY_MAX_DRAWDOWN=0.05

# ------------------------------------------------------------------------------
# 4. Market Data Broker Feeds (Optional — Kotak Neo)
# ------------------------------------------------------------------------------
# Required ONLY if connecting to Kotak Securities Neo live WebSocket/quotes.
# If omitted, AdiTrader operates seamlessly in mock/offline historical mode.
# Note: Real order routing is strictly air-gapped; feeds are read-only (ADR 002).
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_MOBILE_NUMBER=your_registered_mobile_here
KOTAK_PASSWORD=your_login_password_here
KOTAK_UCC=your_client_code_here
KOTAK_MPIN=your_six_digit_mpin_here
KOTAK_TOTP_SECRET=your_totp_seed_secret_here

# ------------------------------------------------------------------------------
# 5. AI Advisory & Vision Providers (Optional — Phase 7)
# ------------------------------------------------------------------------------
# Required ONLY for AI chart vision or multimodal advisory capabilities.
# If omitted, all deterministic strategy, validation, and backtest flows work.
#
# Google Gemini Vision (Chart parsing & support/resistance discovery):
GEMINI_API_KEY=your_gemini_api_key_here
#
# OCR.Space (Fallback high-accuracy chart text/OCR extraction):
OCRSPACE_API_KEY=your_ocrspace_api_key_here
#
# OpenRouter (Unified access to deep reasoning and vision models):
OPENROUTER_API_KEY=your_openrouter_api_key_here
